{
  "name": "mako",
  "private": true,
  "version": "0.0.1",
  "description": "Desktop app for Claude Code, Codex, Cursor, Grok, Devin, and OpenCode.",
  "author": "Verbiflow",
  "license": "MIT",
  "repository": "github:kashyab12/mako",
  "homepage": "https://github.com/kashyab12/mako",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run build:electron && node electron/start.mjs",
    "backend:build": "npm run build --workspace @mako/backend",
    "backend:deploy": "npm run deploy --workspace @mako/backend",
    "backend:dev": "npm run dev --workspace @mako/backend",
    "backend:test": "npm test --workspace @mako/backend",
    "backend:typecheck": "npm run typecheck --workspace @mako/backend",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && tsc -b && vite build",
    "build:all": "npm run build && npm run backend:build",
    "icons": "swiftc -O -o build/make-icns scripts/make-icns.swift && build/make-icns mako-icons/_masters/desktop-gradient.png build/Mako.iconset && iconutil -c icns build/Mako.iconset -o build/Mako.icns && cp build/Mako.iconset/icon_512x512@2x.png public/icons/app-icon.png",
    "lint": "eslint . && npm run lint:anti-slop",
    "lint:anti-slop": "oxlint --config oxlint.config.ts src electron packages/sessions/src packages/backend/app packages/backend/agent packages/backend/scripts packages/backend/src packages/backend/test scripts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "npm run -s build --workspace @mako/sessions && tsc -b --force",
    "typecheck:all": "npm run typecheck && npm run backend:typecheck",
    "test:accounts": "tsx scripts/test-account-usage.ts",
    "test:automations": "tsx scripts/test-automations.ts",
    "test:codex-protocol": "tsx scripts/test-codex-protocol.ts",
    "test:host": "tsx scripts/test-host-domains.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:performance": "tsx scripts/test-performance.ts",
    "verify:mac-release": "tsx scripts/verify-macos-release.ts",
    "test:plugins": "tsx scripts/test-plugins.ts",
    "test:providers": "tsx scripts/test-providers.ts",
    "test:skills": "tsx scripts/test-skills.ts",
    "test:stage": "tsx scripts/test-stage-layout.ts",
    "test:tuning": "tsx scripts/test-tuning-import.ts",
    "test:usage": "tsx scripts/test-usage.ts",
    "test:terminal": "npm run build:electron && tsx scripts/test-terminal-protocol.ts && tsx scripts/test-terminal-writer.ts && tsx scripts/test-terminal-macos.ts && tsx scripts/test-terminal-daemon.ts",
    "preview": "vite preview",
    "package": "npm run package:mac",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "release": "npm run package:mac"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@pierre/diffs": "^1.3.5",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "@zed-industries/claude-code-acp": "^0.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "oxlint": "1.79.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.12",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "build": {
    "appId": "dev.mako.app",
    "productName": "Mako",
    "artifactName": "${productName}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Verbiflow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "mako-icons/_masters/desktop-light.png",
      "mako-icons/_masters/desktop-dark.png",
      "package.json",
      "!**/*.map",
      {
        "from": "packages/sessions",
        "to": "node_modules/@mako/sessions",
        "filter": [
          "package.json",
          "dist/**"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js",
      "makoDistribution": "unsigned"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/Mako.icns",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": true,
      "title": "Mako ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kashyab12",
        "repo": "mako",
        "releaseType": "release"
      }
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "minimatch": "10.2.6"
  }
}
