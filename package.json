{
  "name": "mako",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run build:electron && concurrently -k -n web,electron -c magenta,cyan \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && node electron/start.mjs\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && tsc -b && vite build",
    "icons": "swiftc -O -o build/make-icns scripts/make-icns.swift && build/make-icns mako-icons/dark/desktop-1024.png build/Mako.iconset && iconutil -c icns build/Mako.iconset -o build/Mako.icns",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@pierre/diffs": "^1.3.5",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.9",
    "@zed-industries/claude-code-acp": "^0.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.12",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "dev.mako.app",
    "productName": "Mako",
    "copyright": "Mako",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/Mako.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kashyab12",
        "repo": "mako"
      }
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
